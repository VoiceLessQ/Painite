	"license": "GPL-3.0-only",
	"authors": [
		"NoZeroG"
	],
	"contact": {
		"sources": "https://github.com/VoiceLessQ/Painite"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.apika.painite.PainiteMod"
		],
		"client": [
			"me.apika.painite.PainiteClient"
		]
	},
	"mixins": [
		"painite.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": ">=26.3- <26.4",
		"java": ">=25",
		"fabric-api": "*"
